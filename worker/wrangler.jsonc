{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "galaxy-chat",
  "main": "src/main.ts",
  "compatibility_date": "2026-11-15",
  // Index files (index.bin, centroids.bin, meta.bin, index_manifest.json) are copied into
  // ./assets by the build step (gitignored) and bundled into the script as Data modules, so the
  // index loads at isolate startup rather than inside a request. Limit: 64 MiB uncompressed.
  "rules": [{ "type": "Data", "globs": ["**/*.bin"], "fallthrough": false }],
  "ai": { "binding": "AI" },
  // CORS allow-list (not secret). Local dev overrides it in worker/.dev.vars (see .dev.vars.example).
  "vars": { "ALLOWED_ORIGINS": "https://spookypharaoh.com,https://www.spookypharaoh.com" },
  // Free-plan Rate Limiting binding; counts are per Cloudflare location. Periods must be 10 or 60 s.
  "ratelimits": [
    { "name": "PER_IP", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "GLOBAL", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
