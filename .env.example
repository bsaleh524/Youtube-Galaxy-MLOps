# Copy to .env and fill in. .env is gitignored — never commit real values.
# Keep comments on their own lines: python-dotenv reads "KEY=  # note" as the value "# note".

# ── Cloudflare ────────────────────────────────────────────────────────────────
CLOUDFLARE_ACCOUNT_ID=
# API token with Workers AI permission; used only by the local parity test
CLOUDFLARE_API_TOKEN=
# https://<name>.<subdomain>.workers.dev  (filled in after the first deploy)
WORKER_URL=

# ── Hostinger (static site hosting, SFTP) ─────────────────────────────────────
HOSTINGER_SFTP_HOST=
HOSTINGER_SFTP_PORT=
HOSTINGER_SFTP_USER=
# Set either the password or the key path
HOSTINGER_SFTP_PASSWORD=
HOSTINGER_SFTP_KEY_PATH=
HOSTINGER_REMOTE_DIR=public_html/galaxy
# Must match the remote dir's URL path
SITE_BASE_PATH=/galaxy/
# Used for the Worker's CORS allow-list
SITE_ORIGIN=https://spookypharaoh.com

# ── Optional ──────────────────────────────────────────────────────────────────
# Only if choosing Groq over Workers AI for `ask` mode
GROQ_API_KEY=
# Optional mounted path for raw-scrape backups
SYNOLOGY_BACKUP_DIR=

# ── Pipeline ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Chosen at Checkpoint 2 (2026-11-18): 120. Goal is more niche clusters once issue #5 is fixed.
N_CLUSTERS=120
# 5000 is taken by macOS AirPlay Receiver
MLFLOW_PORT=5001
